NODE_ENV=development
PORT=4000
DATABASE_URL=file:./dev.db
JWT_ACCESS_SECRET=replace-with-a-random-string-of-32-characters-or-more
JWT_REFRESH_SECRET=replace-with-another-random-string-of-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGIN=http://localhost:5173
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
UPLOAD_DIR=./uploads
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=JobPilot <noreply@jobpilot.local>
RATE_LIMIT_DISABLED=false
WEB_DIST=
BCRYPT_ROUNDS=12
TRUST_PROXY=false
